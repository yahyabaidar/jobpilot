# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — consumed by django-environ's env.db()
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# "db" is the Postgres service name in docker-compose.yml
DATABASE_URL=postgres://jobpilot:jobpilot@db:5432/jobpilot

# LLM — any OpenAI-compatible endpoint (OpenAI, Groq, Gemini, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# France Travail (offres d'emploi API) — https://francetravail.io/data/api/offres-emploi
# Create an app at https://francetravail.io to get these ; leave empty to disable this source.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
